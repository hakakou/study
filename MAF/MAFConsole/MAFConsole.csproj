	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SharedConfig\SharedConfig.csproj" />
	</ItemGroup>


	<ItemGroup>
		<None Update="**/*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Using Include="SharedConfig" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Haka\MEF\" />
	</ItemGroup>
